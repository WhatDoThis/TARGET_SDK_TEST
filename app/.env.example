# =============================================================================
# App 환경변수 템플릿 (이 파일은 Git에 포함 · 실값은 넣지 말 것)
# =============================================================================
# 사용법:
#   1) 이 파일을 복사해 app/.env 생성  (app/.env 는 .gitignore)
#   2) 각 키의 **출처(Adobe 콘솔)** 에서 값을 복사해 .env 에 넣음
#   3) EAS 클라우드 빌드: Expo 프로젝트 Secrets에 동일 키 등록
#      (eas.json 의 env 는 public용 플레이스홀더만 유지)
# =============================================================================

# --- 본선 (골든 패스) ---
# 출처: Tags → Mobile property → Development Environment → Environment File ID
# 형식: <company>/<property>/launch-xxxx-development
EXPO_PUBLIC_ADOBE_MOBILE_APP_ID=<org>/<property>/launch-xxxx-development

# 출처: Target Form-based 활동 Location (코드 decisionScope 와 동일)
EXPO_PUBLIC_DECISION_SCOPE=aep-app-test-scope

# --- Troubleshooting only (고객 데모 본선에 넣지 말 것) ---
# 출처: Data Collection → Datastreams → Datastream ID (UUID)
# EXPO_PUBLIC_DEBUG_EDGE_CONFIG_ID=<DATASTREAM_UUID>

# 출처: Edge Network host (Adobe 기본 또는 샌드박스 FPC 도메인)
# EXPO_PUBLIC_DEBUG_EDGE_DOMAIN=edge.adobedc.net

# 출처: IMS Org ID — Tags 원격 JSON experienceCloud.org 와 동일 (…@AdobeOrg)
# EXPO_PUBLIC_DEBUG_EXPERIENCE_CLOUD_ORG=<IMS_ORG>@AdobeOrg
