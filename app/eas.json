{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ADOBE_MOBILE_APP_ID": "<org>/<property>/launch-xxxx-development",
        "EXPO_PUBLIC_DECISION_SCOPE": "aep-app-test-scope",
        "EXPO_PUBLIC_DEBUG_EDGE_CONFIG_ID": "",
        "EXPO_PUBLIC_DEBUG_EDGE_DOMAIN": "",
        "EXPO_PUBLIC_DEBUG_EXPERIENCE_CLOUD_ORG": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ADOBE_MOBILE_APP_ID": "<org>/<property>/launch-xxxx-development",
        "EXPO_PUBLIC_DECISION_SCOPE": "aep-app-test-scope",
        "EXPO_PUBLIC_DEBUG_EDGE_CONFIG_ID": "",
        "EXPO_PUBLIC_DEBUG_EDGE_DOMAIN": "",
        "EXPO_PUBLIC_DEBUG_EXPERIENCE_CLOUD_ORG": ""
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
