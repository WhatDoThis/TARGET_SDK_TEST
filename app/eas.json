{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ADOBE_MOBILE_APP_ID": "<org>/<property>/launch-xxxx-development",
        "EXPO_PUBLIC_EDGE_CONFIG_ID": "<DATASTREAM_UUID>",
        "EXPO_PUBLIC_EDGE_DOMAIN": "edge.adobedc.net",
        "EXPO_PUBLIC_DECISION_SCOPE": "aep-app-test-scope",
        "EXPO_PUBLIC_ASSURANCE_SESSION_URL": "aepsdktargettest://?adb_validation_sessionid=<ASSURANCE_SESSION_ID>"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ADOBE_MOBILE_APP_ID": "<org>/<property>/launch-xxxx-development",
        "EXPO_PUBLIC_EDGE_CONFIG_ID": "<DATASTREAM_UUID>",
        "EXPO_PUBLIC_EDGE_DOMAIN": "edge.adobedc.net",
        "EXPO_PUBLIC_DECISION_SCOPE": "aep-app-test-scope",
        "EXPO_PUBLIC_ASSURANCE_SESSION_URL": "aepsdktargettest://?adb_validation_sessionid=<ASSURANCE_SESSION_ID>"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
